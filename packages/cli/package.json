{
  "name": "code-walkthrough",
  "version": "0.1.0",
  "description": "◆ Understand any codebase in 5 minutes — scan a project, get an interactive guided architecture tour in your browser",
  "type": "module",
  "bin": {
    "walkthrough": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "code-visualization",
    "architecture",
    "codebase-understanding",
    "onboarding",
    "dependency-graph",
    "developer-tools",
    "static-analysis",
    "nextjs",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyooosukedn/walkthrough.git"
  },
  "author": "Daniel Purnomo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kyooosukedn/walkthrough/issues"
  },
  "homepage": "https://github.com/kyooosukedn/walkthrough#readme",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js && node scripts/bundle-visualizer.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\"",
    "test": "esbuild src/*.test.ts --bundle --platform=node --format=esm --outdir=.test --out-extension:.js=.mjs --log-level=warning && node --test .test/*.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@walkthrough/scanner": "^0.1.0",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
